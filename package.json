{
  "name": "@pinkqween/mathunitsjs",
  "version": "3.1.0",
  "description": "A robust, type-safe physical units and dimensional analysis library in TypeScript",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "math",
    "units",
    "dimensional-analysis",
    "physics",
    "planck-units",
    "si-units",
    "typescript",
    "temperature",
    "currency",
    "measurement"
  ],
  "homepage": "https://github.com/pinkqween/MathUnitsJS#readme",
  "bugs": {
    "url": "https://github.com/pinkqween/MathUnitsJS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinkqween/MathUnitsJS.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "pinkqween",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "tsup": "^8.5.1",
    "typescript": "^5"
  }
}
